<div id="reading-progress-bar"></div>

<script>
  function initEnhancements() {
    const content = document.querySelector('.sl-markdown-content');
    if (!content) return;

    if (!document.getElementById('reading-progress-bar')) {
      const progressBar = document.createElement('div');
      progressBar.id = 'reading-progress-bar';
      document.body.appendChild(progressBar);
    }

    window.addEventListener('scroll', () => {
      const bar = document.getElementById('reading-progress-bar');
      if (!bar) return;
      const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = totalHeight > 0 ? (window.scrollY / totalHeight) * 100 : 0;
      bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    });

    if (!document.querySelector('.reading-meta-badge')) {
      const text = content.textContent || '';
      const wordCount = text.trim().split(/\s+/).length;
      const readingTime = Math.ceil(wordCount / 200);

      const metaBadge = document.createElement('div');
      metaBadge.className = 'reading-meta-badge';
      metaBadge.innerHTML = `<span>⏱️ ${readingTime} min read</span><span>•</span><span>📊 ${wordCount.toLocaleString()} words</span>`;

      const titleHeader = content.querySelector('h1');
      if (titleHeader) {
        titleHeader.after(metaBadge);
      }
    }

    const h2Elements = Array.from(content.querySelectorAll('h2'));

    if (h2Elements.length >= 2) {
      const exerciseH2 = h2Elements[h2Elements.length - 2];

      if (exerciseH2 && !exerciseH2.parentElement?.classList.contains('solved-exercise-summary')) {
        const details = document.createElement('details');
        details.className = 'solved-exercise-accordion';

        const summary = document.createElement('summary');
        summary.className = 'solved-exercise-summary';
        const originalTitle = exerciseH2.textContent || 'Exercise Solution';
        summary.innerHTML = `<span>💡 ${originalTitle}</span><span class="accordion-badge">Click to Expand Solution</span>`;

        const wrapper = document.createElement('div');
        wrapper.className = 'solved-exercise-content';

        let curr = exerciseH2.nextElementSibling;
        const nodesToMove = [];
        const lastH2 = h2Elements[h2Elements.length - 1];

        while (curr && curr !== lastH2) {
          nodesToMove.push(curr);
          curr = curr.nextElementSibling;
        }

        exerciseH2.replaceWith(details);
        details.appendChild(summary);
        details.appendChild(wrapper);
        nodesToMove.forEach((node) => wrapper.appendChild(node));
      }
    }
    
    if (h2Elements.length > 1 && !document.querySelector('.initial-toc-card')) {
      const overviewCard = document.createElement('div');
      overviewCard.className = 'initial-toc-card';

      let tocListHTML = '<div class="initial-toc-header"><span>📋 Lesson Topics Overview</span></div><ul class="initial-toc-list">';
      h2Elements.forEach((h2, index) => {
        if (!h2.id) {
          h2.id = `section-h2-${index}`;
        }
        tocListHTML += `<li><a href="#${h2.id}">${h2.textContent?.replace(/^#+\s*/, '')}</a></li>`;
      });
      tocListHTML += '</ul>';

      overviewCard.innerHTML = tocListHTML;

      const metaBadge = content.querySelector('.reading-meta-badge');
      if (metaBadge) {
        metaBadge.after(overviewCard);
      } else {
        const titleHeader = content.querySelector('h1');
        if (titleHeader) titleHeader.after(overviewCard);
      }
    }

    if (h2Elements.length > 0 && !document.querySelector('.global-collapse-controls')) {
      const controlsDiv = document.createElement('div');
      controlsDiv.className = 'global-collapse-controls';
      controlsDiv.innerHTML = `
        <button id="btn-expand-all" class="qol-btn">📖 Expand All Sections</button>
        <button id="btn-collapse-all" class="qol-btn">📕 Collapse All Sections</button>
      `;

      const initialToc = content.querySelector('.initial-toc-card');
      if (initialToc) {
        initialToc.after(controlsDiv);
      }

      document.getElementById('btn-expand-all')?.addEventListener('click', () => {
        document.querySelectorAll('.collapsible-h2-section').forEach((sec) => sec.classList.remove('is-collapsed'));
      });

      document.getElementById('btn-collapse-all')?.addEventListener('click', () => {
        document.querySelectorAll('.collapsible-h2-section').forEach((sec) => sec.classList.add('is-collapsed'));
      });
    }

    h2Elements.forEach((h2, idx) => {
      if (idx === h2Elements.length - 2) return;
      if (h2.parentElement?.classList.contains('collapsible-h2-header')) return;

      const sectionWrapper = document.createElement('div');
      sectionWrapper.className = 'collapsible-h2-section';

      const headerWrapper = document.createElement('div');
      headerWrapper.className = 'collapsible-h2-header';
      
      const toggleIcon = document.createElement('span');
      toggleIcon.className = 'h2-toggle-icon';
      toggleIcon.textContent = '▼';

      h2.before(sectionWrapper);
      headerWrapper.appendChild(toggleIcon);
      headerWrapper.appendChild(h2);
      sectionWrapper.appendChild(headerWrapper);

      const bodyWrapper = document.createElement('div');
      bodyWrapper.className = 'collapsible-h2-body';

      let curr = sectionWrapper.nextElementSibling;
      const nodesToMove = [];
      const stopTarget = idx < h2Elements.length - 2 ? h2Elements[idx + 1] : null;

      while (curr && curr !== stopTarget && !curr.classList.contains('solved-exercise-accordion')) {
        nodesToMove.push(curr);
        curr = curr.nextElementSibling;
      }

      nodesToMove.forEach((node) => bodyWrapper.appendChild(node));
      sectionWrapper.appendChild(bodyWrapper);

      headerWrapper.addEventListener('click', () => {
        sectionWrapper.classList.toggle('is-collapsed');
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initEnhancements);
  document.addEventListener('astro:page-load', initEnhancements);
</script>
